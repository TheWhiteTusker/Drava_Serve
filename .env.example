# Copy to .env. Read by pnpm dev:api, pnpm test, pnpm db:migrate and pnpm seed.
# Development and tests use a Neon project; production (Supabase) is set only in Vercel. Never put the
# production database here: the tests create and drop databases.

# Neon → Connect, with connection pooling on. Encode special characters in the password ($ → %24, @ → %40).
POSTGRES_URL=postgresql://neondb_owner:<password>@ep-<name>-pooler.<region>.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
CONTROL_DB_NAME=fnb_control

# Optional. Without it, the session key is derived from POSTGRES_URL.
# JWT_SECRET=

# File uploads (photos, vendor bills, order PDFs). Supabase → Storage → Settings → S3 Connection.
# Needed for uploads and for the purchasing and dashboard tests.
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

PORT=3000
