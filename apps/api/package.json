{
  "name": "@fnb/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/main.ts",
    "cli": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/cli.ts",
    "db:generate": "drizzle-kit generate --config drizzle.tenant.ts && drizzle-kit generate --config drizzle.control.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@fnb/shared": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/platform-socket.io": "12.1.2",
    "@nestjs/websockets": "12.1.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.3.12",
    "drizzle-orm": "0.45.4",
    "fflate": "^0.8.3",
    "ioredis": "^6.0.0",
    "pdfkit": "^0.20.2",
    "pg": "8.23.1",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "1.16.13",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "0.31.11",
    "socket.io-client": "4.8.3",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  },
  "type": "module"
}
