{
  "name": "fnb",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @fnb/api dev",
    "dev:admin": "pnpm --filter @fnb/admin dev",
    "test": "pnpm --filter @fnb/shared build && pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @fnb/api cli migrate",
    "customer:create": "pnpm --filter @fnb/api cli customer:create",
    "seed": "pnpm --filter @fnb/api cli seed",
    "user:password": "pnpm --filter @fnb/api cli user:password"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
