{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": {
      "root": "apps/admin",
      "framework": "vite",
      "buildCommand": "pnpm --filter @fnb/shared build && pnpm run build",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "field": {
      "root": "apps/field",
      "framework": "vite",
      "buildCommand": "pnpm --filter @fnb/shared build && pnpm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/pos/(.*)", "destination": "/pos/index.html" },
        { "source": "/receiving/(.*)", "destination": "/receiving/index.html" },
        { "source": "/kitchen/(.*)", "destination": "/kitchen/index.html" },
        { "source": "/m/(.*)", "destination": "/menu/index.html" }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "buildCommand": "pnpm --filter @fnb/shared build && if [ \"$VERCEL_ENV\" = production ]; then pnpm cli migrate; fi"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(pos|receiving|kitchen|m|menu|field-assets)/(.*)", "destination": { "service": "field" } },
    { "source": "/icon.svg", "destination": { "service": "field" } },
    { "source": "/(.*)", "destination": { "service": "admin" } }
  ]
}
